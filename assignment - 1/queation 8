#include <iostream>
using namespace std;

int main() {
    int experience, performance;

    cin >> experience >> performance;

    if (experience < 3) {
        cout << "Level: Junior";
    }
    else if (experience <= 7) {
        if (performance >= 80) {
            cout << "Level: Mid-Level";
        } else {
            cout << "Level: Junior";
        }
    }
    else {
        if (performance >= 85) {
            cout << "Level: Senior";
        } else {
            cout << "Level: Mid-Level";
        }
    }

    return 0;
}
